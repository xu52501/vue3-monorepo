{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build:ui": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "packages/ui/dist/index.js"
      ],
      "inputs": [
        "packages/ui/src/**/*",
        "packages/ui/package.json",
        "packages/ui/vite.config.ts"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": [
        "build:ui",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "lib/**"
      ],
      "inputs": [
        "src/**/*",
        "package.json"
      ]
    },
    "dev": {
      "dependsOn": [
        "build:ui"
      ],
      "cache": false
    }
  }
}